# Copy to .env and fill in the key for the provider you want. .env is gitignored.

# Which backend to use: "anthropic" (default) or "deepseek"
LLM_PROVIDER=deepseek

# --- DeepSeek (OpenAI-compatible) -------------------------------------------
# Key from https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-key
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Anthropic --------------------------------------------------------------
# Key from https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-your-key
# ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Optional ---------------------------------------------------------------
# Where the database lives. Defaults to backend/data/historical.db
# DATABASE_PATH=./backend/data/historical.db

# Extra origins allowed to call the API (comma separated). The dev server's
# origin is allowed by default.
# CORS_ORIGINS=http://localhost:5173

# Where the dev frontend sends proxied requests. Defaults to http://127.0.0.1:8000
# VITE_API_TARGET=http://127.0.0.1:8000
